{
  "name": "@khorsheed/dsh-ankh-guard",
  "description": "Hard gate for self-modification restarts: a green-build credential bound to the git HEAD, checked before any restart of the running instance",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khorsheed/dsh-plugins.git",
    "directory": "packages/ankh-guard"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-ankh-guard": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cli": {
      "types": "./lib/types/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "scripts/dsh-watchdog.sh",
    "scripts/on-install.js",
    "scripts/install-launchd.sh",
    "scripts/install-systemd.sh",
    "skills/**/*.md",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "test": "pnpm run build && pnpm run test:reclaim && node scripts/run-test-lane.mjs all",
    "test:unit": "node scripts/run-test-lane.mjs unit",
    "test:integration": "pnpm run build && pnpm run test:reclaim && node scripts/run-test-lane.mjs integration",
    "test:reclaim": "tsx scripts/report-test-leaks.ts --reclaim --age-ms 86400000 --summary",
    "test:leaks": "tsx scripts/report-test-leaks.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepare": "npm run build && node scripts/on-install.js",
    "postinstall": "node scripts/on-install.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "guard",
    "self-modification",
    "self-restart",
    "watchdog",
    "canary",
    "rollback"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "compat": {
      "minHost": "0.1.2-rc.1",
      "notes": "composition-preflight runs via the standalone preflight-runner and degrades to a notice when no live harness checkout resolves; original-tab browser handoff feature-probes optional WebServer/connection auth seams; reversible state quarantine was exercised in a live 0.1.1-rc.2 to 0.1.2-alpha.4 cutover",
      "verifiedHost": "0.1.2-rc.1"
    }
  }
}
