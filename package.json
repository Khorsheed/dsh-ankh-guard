{
  "name": "@khorsheed/dsh-ankh-guard",
  "description": "Hard gate for self-modification restarts: a green-build credential bound to the git HEAD, checked before any restart of the running instance",
  "version": "0.1.0-rc.6.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khorsheed/dsh-ankh-guard.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-ankh-guard": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cli": {
      "types": "./lib/types/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "scripts/dsh-watchdog.sh",
    "cordis.patch.yml",
    "README.en.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.5 || ^0.1.0-rc.5",
    "@deepseek-ai/dsh-agent-presets": "^0.0.1-rc.5 || ^0.1.0-rc.5",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.5 || ^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.5 || ^0.1.0-rc.5",
    "@deepseek-ai/dsh-session-persistence": "^0.0.1-rc.5 || ^0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1-rc.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "guard",
    "self-modification",
    "self-restart",
    "watchdog",
    "canary",
    "rollback"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
